# Generic job-search workspace. Everything personal stays out of git by default.
# If your copy of this repo is PRIVATE and you want your data backed up in git,
# enable the optional block at the bottom (remove the leading "#> ").

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Compiled documents (never commit a PDF: it holds your contact details)
*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Secrets and personal media
.env
.env.*
*.jpg
*.jpeg
*.png

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Agent local state
.claude/settings.local.json
.claude/projects/
skills-lock.json

# Your documents and generated applications (made by /onboard and /apply)
cv/main_*
cv/*.txt
cover_letters/cover_*
cover_letters/Cover_*
documents/cv/**
documents/linkedin/**
documents/diplomas/**
documents/references/**
documents/postings/**
documents/interview/**
documents/applications/*
!documents/applications/.gitkeep

# Your search history
job_search_tracker.csv
outreach_tracker.csv
outreach/*
!outreach/.gitkeep
# Previous-version copies left by tools/outreach.py's atomic writes.
*.bak
reports/*
!reports/.gitkeep
company_research/*.json

# Scratch builds
tmp/

# PRIVATE-REPO OVERRIDES (optional, off by default)
# Later patterns win, so these lines re-include your data. Enable them only in a
# PRIVATE repo. In a public repo your data would be published.
#> !documents/applications/*
#> !job_search_tracker.csv
#> !outreach_tracker.csv
#> !outreach/*
#> !reports/*
#> !company_research/*.json
#> !cv/main_*.tex
#> !cover_letters/cover_*.tex
# Never tracked, whatever the lines above say:
.env
.env.*
# Names that must never appear in outreach messages (see tools/outreach.py check-message).
outreach/_denylist.txt
